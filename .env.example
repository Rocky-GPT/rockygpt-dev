# The Brain service.
BRAIN_URL=http://127.0.0.1:8000

# Optional access token for a protected environment; must match the Brain.
STAGING_SERVICE_TOKEN=

# Optional, and unused while the Feedback page is switched off: sorts ratings with Jev.
# The same key as the Brain's BRAIN_TYPESAFE_API_KEY. Server-side only; never
# give it a NEXT_PUBLIC_ name.
TYPESAFE_API_KEY=
