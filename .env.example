# --- Upstream ---
# The brain. Everything this app shows arrives over HTTP from here.
BRAIN_URL=http://127.0.0.1:8000

# Bearer token for the brain's /v1/admin/* routes. Must match the brain's own
# ADMIN_API_TOKEN. Note that when the BRAIN's value is empty its check_admin is
# a no-op and the logs are open to anything that can reach it, regardless of
# what this app does.
ADMIN_API_TOKEN=

# Milliseconds before a proxied brain call is abandoned. A chat turn runs three
# sequential model round-trips; 60s is not always enough on a cold brain, and a
# premature abort looks like a failed answer rather than a slow one.
BRAIN_TIMEOUT_MS=120000

# --- Deliberately absent ---
# DATA_URL      the campus data service is retired; this app never calls it
# DATABASE_URL  this app never connects to Neon. It reads through the brain.
# ABUSE_HASH_KEY  no rate limiter here; bulk runs must not be throttled
